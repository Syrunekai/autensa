# ====================================
# Mission Control Configuration
# ====================================

# ====================================
# System Settings
# ====================================

# Server port (default: 4000)
# PORT=4000

# Database path (default: ./mission-control.db)
DATABASE_PATH=./mission-control.db

# Gateway / endpoint URL (default: ws://127.0.0.1:18789)
# Accepts an OpenClaw Gateway (ws/wss) OR any OpenAI-compatible endpoint (http/https).
# For remote connections via Tailscale: wss://your-machine.tail12345.ts.net
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# Gateway authentication token / API key (required for remote or hosted endpoints)
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Model the gateway/endpoint should serve (default: openclaw/default).
# Set to any model id your configured gateway exposes.
OPENCLAW_GATEWAY_MODEL=

# Model discovery mode (default: auto)
# - remote: Query models from the connected OpenClaw Gateway via RPC
# - local:  Read models from local ~/.openclaw/openclaw.json config file
# - auto:   Try remote first, fall back to local, then common defaults
# MODEL_DISCOVERY=auto

# ====================================
# Authorization
# ====================================

# Browser login access key — the whole app (pages + API) sits behind /login.
# Generate with: openssl rand -base64 24
# Store it in your password manager; you type it into browsers once.
# Unset: auth is disabled only when MC_API_TOKEN is also unset (local dev).
# Production REQUIRES it — the server fails closed (503) without it.
# Rotating it logs out every browser session (the stolen-cookie kill switch).
MC_UI_TOKEN=

# API bearer token for automation and server self-calls
# Required in production — the server fails closed (503) without it.
# If unset in dev (together with MC_UI_TOKEN), authentication is DISABLED.
# Generate with: openssl rand -hex 32
MC_API_TOKEN=

# ====================================
# LLM Cost Saving Limits
# ====================================
# Per-call caps to bound token spend / runtime. 0 / unset / invalid falls back to
# the built-in default shown on each line — never unlimited; the defaults ARE the
# safety ceiling. Set a positive value to override.

# Max output (completion) tokens the model may generate per call.
# Too low TRUNCATES large structured outputs (e.g. ideation JSON) → parse failure.
LLM_MAX_OUTPUT_TOKENS=32768        # 32K — code default; 0/unset falls back to this

# Max wall-clock SECONDS a single LLM call may run before it is aborted.
# Too low kills long generations mid-flight.
# NOTE: with LLM_STREAM on (the default) this is an IDLE window — max seconds of
# silence between chunks, not total duration. A healthy stream can run longer.
LLM_REQUEST_TIMEOUT_SECONDS=900    # 15 minutes — code default; 0/unset falls back to this

# ====================================
# LLM Request Behavior
# ====================================

# Response streaming (default: ON). Streaming keeps the connection alive past
# gateway idle-timeouts (e.g. Cloudflare ~100s, some gateways ~300s) that kill
# long buffered generations with 504/524 errors. Set to "false"/"0"/"off" only
# to diagnose SSE issues with a provider.
# LLM_STREAM=true

# Optional sampling temperature. Unset/empty → the parameter is OMITTED from
# requests entirely and each provider/model applies its own default.
# Risks of setting it: modern reasoning models reject or forbid custom
# temperatures (Claude Opus 4.7+/Fable 5 return 400 if the field is present at
# all; OpenAI GPT-5-series rejects values other than 1; Kimi K2.6 accepts only
# mode-fixed values). Ranges also differ by provider (0-1 vs 0-2).
# 0 is a valid value where supported.
# LLM_TEMPERATURE=

# Optional reasoning/thinking effort. Unset/empty → the field is OMITTED from
# requests entirely and the model uses its own default.
# Common values: none, low, medium, high, xhigh, max — SUPPORT VARIES BY MODEL
# (e.g. some lower-end models stop at high or xhigh). If using a reasoning
# model, medium or high is a reasonable starting point.
# Models defined in src/lib/autopilot/model-definitions.ts are validated and
# misconfiguration fails fast with a clear error; unknown models pass any
# value through to the provider, which validates it.
# LLM_REASONING_EFFORT=

# ====================================
# Planning Configuration
# ====================================

# Planning timeout in milliseconds (default: 30000 = 30 seconds)
# How long to wait for Charlie to respond to a planning question
PLANNING_TIMEOUT_MS=30000

# Planning poll interval in milliseconds (default: 2000 = 2 seconds)
# How frequently to poll for updates from OpenClaw during planning
PLANNING_POLL_INTERVAL_MS=2000

# ====================================
# Workspace Configuration
# ====================================

# Mission Control API URL (auto-detected if not set)
# Override for remote access or custom deployments
# MISSION_CONTROL_URL=http://localhost:4000

# Base workspace directory (default: ~/Documents/Shared)
# All Mission Control files are stored here
# WORKSPACE_BASE_PATH=~/Documents/Shared

# Projects directory (default: ~/Documents/Shared/projects)
# Each project gets a unique folder here
# PROJECTS_PATH=~/Documents/Shared/projects

# ====================================
# Agent Configuration
# ====================================

# Allow dynamic agent generation (default: true)
# When set to false, Mission Control will only use imported/manually-created agents
# and skip any runtime agent generation during planning and sub-agent spawning.
# ALLOW_DYNAMIC_AGENTS=true

# ====================================
# Security
# ====================================

# Webhook signature secret for the agent-completion webhook
# If not set, the webhook REJECTS all requests (fail closed).
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# ====================================
# Jira Cloud Integration (Optional)
# ====================================
# JIRA_SYNC=false
# JIRA_URL=https://yourorg.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=
# Required when JIRA_SYNC=true — the webhook rejects requests without it (fail closed)
# JIRA_WEBHOOK_SECRET=

# ====================================
# Security Notes
# ====================================
#
# NEVER commit this file with real values!
# This is a template - copy to .env.local and configure:
#
#   cp .env.example .env.local
#
# Then edit .env.local with your actual values.
# .env.local is gitignored and will not be committed.
